#!/bin/bash
# ============================================================
# HK new-api 标准部署脚本（防覆盖收敛版 v2，2026-08-11 落地）
#
# 【收敛目标】修复「标准重建覆盖移动端/集群路由」流程缺陷（08-09/08-10/08-11 三度复发）
#   根因：deploy-hk.sh 把 new-api.new 直接 cp 覆盖线上，若 new-api.new 是标准上游
#   重建版（不含 xxsx 自定义补丁），会打掉 /api/mobile/admin/* 与 /api/cluster/* 路由，
#   导致 APP 失联、检查更新失败。
#
# 【防复发三铁律】
#   1) 绝不覆盖 known-good 工作版：new-api.bak.20260808-docs（含全部路由的 xxsx 补丁版）
#      是线上工作基线，本脚本只备份当前版到 server-backups/，绝不触碰该工作版。
#   2) 部署前强制校验：new-api.new 必须含 xxsx 自定义路由（app-release>0 且
#      mobile/admin>0 且 cluster/state>0），缺失即拒绝部署并留痕，杜绝 noroutes 版上线。
#   3) 全程留痕：每次部署（含被拒）写入 /opt/xxsx-api/deploy-history.log。
#
# 用法：
#   deploy-hk.sh                  完整部署（带校验+留痕）
#   deploy-hk.sh --check [源]     仅校验路由，不部署（dry-run 自检；[源] 可选，默认 new-api.new）
# ============================================================
set -e

DEPLOY_LOG=/opt/xxsx-api/deploy-history.log
BIN_DIR=/opt/xxsx-api/bin
BK_DIR=/opt/xxsx-api/server-backups
SRC=$BIN_DIR/new-api.new
KNOWN_GOOD=$BIN_DIR/new-api.bak.20260808-docs
TS=$(date +%Y%m%d-%H%M%S)

log() { echo "[deploy] $TS $*" | tee -a "$DEPLOY_LOG"; }

# --check 指定候选源（仅 dry-run 用，不落盘、不部署）
if [ "$1" = "--check" ] && [ -n "$2" ]; then
  SRC="$2"
fi

# ---------- 0) 保护工作版基线存在性提示 ----------
if [ -f "$KNOWN_GOOD" ]; then
  log "known-good 工作版存在（$KNOWN_GOOD），本次部署不会覆盖它。"
else
  log "WARN: known-good 工作版（$KNOWN_GOOD）缺失！若部署失败请勿恢复标准版。"
fi

# ---------- 1) 必检：源文件存在 ----------
if [ ! -f "$SRC" ]; then
  log "拒绝部署：$SRC 不存在（防止覆盖当前工作版）。"
  echo "ERROR: $SRC 不存在，中止部署。"
  exit 1
fi

# ---------- 2) 路由校验（关键防复发）----------
REQ_APP=$(strings "$SRC" | grep -c "app-release" || true)
REQ_MOB=$(strings "$SRC" | grep -c "mobile/admin" || true)
REQ_CLU=$(strings "$SRC" | grep -c "cluster/state" || true)
log "路由预检 $SRC: app-release=$REQ_APP mobile/admin=$REQ_MOB cluster/state=$REQ_CLU"

if [ "$REQ_APP" -lt 1 ] || [ "$REQ_MOB" -lt 1 ] || [ "$REQ_CLU" -lt 1 ]; then
  log "拒绝部署：$SRC 缺失 xxsx 自定义路由（app-release=$REQ_APP, mobile/admin=$REQ_MOB, cluster/state=$REQ_CLU），疑似标准重建版。已中止。"
  echo "ERROR: $SRC 缺少 xxsx 自定义路由补丁，拒绝部署！"
  echo "  app-release=$REQ_APP  mobile/admin=$REQ_MOB  cluster/state=$REQ_CLU"
  echo "  请改用含补丁版本；紧急回退请用 $KNOWN_GOOD 恢复工作版。"
  exit 2
fi

# --check 模式：只校验不部署
if [ "$1" = "--check" ]; then
  log "dry-run 校验通过（未部署）。"
  echo "CHECK_OK: new-api.new 路由齐备，可安全部署。"
  exit 0
fi

# ---------- 3) 备份当前版（到 server-backups/，绝不覆盖工作版）----------
mkdir -p "$BK_DIR"
cp "$BIN_DIR/new-api" "$BK_DIR/new-api.bak.cluster-chat-$TS"
log "已备份当前版 -> $BK_DIR/new-api.bak.cluster-chat-$TS"

# ---------- 4) 停服 + 覆盖 + 起服（原逻辑保留）----------
systemctl stop xxsx-api-mi
sleep 2
FUSER=$(fuser "$BIN_DIR/new-api" 2>/dev/null || true)
if [ -n "$FUSER" ]; then log "kill leftover holders: $FUSER"; kill $FUSER 2>/dev/null || true; sleep 1; fi
rm -f "$BIN_DIR/new-api"
cp "$SRC" "$BIN_DIR/new-api"
chmod +x "$BIN_DIR/new-api"
chown root:root "$BIN_DIR/new-api"
NEW_MD5=$(md5sum "$BIN_DIR/new-api" | awk '{print $1}')
systemctl start xxsx-api-mi
sleep 3

# ---------- 5) 部署后复核 + 留痕 ----------
ACT=$(systemctl is-active xxsx-api-mi)
POST_APP=$(strings "$BIN_DIR/new-api" | grep -c "app-release" || true)
log "部署完成: 新版 md5=$NEW_MD5 路由(app-release)=$POST_APP 服务=$ACT"
echo "BACKUP_DONE $TS"
echo "NEW_MD5 $NEW_MD5"
echo "SERVICE $ACT"
if [ "$ACT" != "active" ] || [ "$POST_APP" -lt 1 ]; then
  log "WARN: 部署后服务或路由异常，请立即用 $KNOWN_GOOD 回退！"
  exit 3
fi
echo "DEPLOY_OK"
