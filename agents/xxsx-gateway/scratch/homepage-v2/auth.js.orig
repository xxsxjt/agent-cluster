// auth.js — xxssxx.top 统一登录状态管理
// 使用 /games-api/auth/login|register|verify，token 存 localStorage + .xxssxx.top cookie

(function () {
  'use strict';

  var STORAGE_KEY = 'xxsx-games-auth-account';
  var COOKIE_NAME = 'xxsx-session';
  var COOKIE_DOMAIN = '.xxssxx.top';
  var LOGIN_PATH   = '/games-api/auth/login';
  var REG_PATH     = '/games-api/auth/register';
  var CONFIG_PATH  = '/games-api/auth/config';
  var TS_SITE_KEY  = ''; // filled from /games-api/auth/config
  var tsWidgetLogin    = null;
  var tsWidgetRegister = null;

  // ── Storage ─────────────────────────────────────────────────────────────────
  function getAuth() {
    try {
      var s = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (s && typeof s.token === 'string' && Number(s.expiresAt) > Date.now()) return s;
    } catch (e) {}
    return null;
  }

  function saveAuth(data) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    var maxAge = Math.max(0, Math.floor((Number(data.expiresAt) - Date.now()) / 1000));
    document.cookie = COOKIE_NAME + '=' + encodeURIComponent(data.token) +
      '; Domain=' + COOKIE_DOMAIN + '; Path=/; Secure; SameSite=Lax; Max-Age=' + maxAge;
  }

  function clearAuth() {
    localStorage.removeItem(STORAGE_KEY);
    document.cookie = COOKIE_NAME + '=; Domain=' + COOKIE_DOMAIN + '; Path=/; Max-Age=0; Secure; SameSite=Lax';
  }

  // ── API ─────────────────────────────────────────────────────────────────────
  function apiFetch(path, body) {
    return fetch(path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
      credentials: 'same-origin',
    }).then(function (r) { return r.json(); });
  }

  function apiGet(path) {
    return fetch(path, { credentials: 'same-origin' }).then(function (r) { return r.json(); });
  }

  // ── Turnstile ───────────────────────────────────────────────────────────────
  function loadTurnstileScript() {
    if (document.querySelector('script[data-turnstile]')) return;
    var s = document.createElement('script');
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    s.defer = true;
    s.setAttribute('data-turnstile', '1');
    document.head.appendChild(s);
  }

  function renderTurnstile(containerId) {
    if (!TS_SITE_KEY) return null;
    var el = document.getElementById(containerId);
    if (!el) return null;
    el.innerHTML = '';
    if (typeof window.turnstile === 'undefined') return null;
    return window.turnstile.render(el, { sitekey: TS_SITE_KEY, theme: 'light', size: 'normal' });
  }

  function getTsToken(widgetId) {
    if (widgetId === null || typeof window.turnstile === 'undefined') return '';
    try { return window.turnstile.getResponse(widgetId) || ''; } catch (e) { return ''; }
  }

  function resetTs(widgetId) {
    if (widgetId === null || typeof window.turnstile === 'undefined') return;
    try { window.turnstile.reset(widgetId); } catch (e) {}
  }

  // ── Nav UI ──────────────────────────────────────────────────────────────────
  function updateNav() {
    var auth = getAuth();
    var loginBtn = document.getElementById('nav-login-btn');
    var badge    = document.getElementById('nav-user-badge');
    var nameEl   = document.getElementById('nav-username');
    if (!loginBtn || !badge) return;
    if (auth) {
      loginBtn.hidden = true;
      badge.hidden = false;
      if (nameEl) nameEl.textContent = auth.identity && auth.identity.displayName || auth.identity.username || '用户';
    } else {
      loginBtn.hidden = false;
      badge.hidden = true;
    }
  }

  // ── Modal ──────────────────────────────────────────────────────────────────
  var modal, activeTab;

  function openModal(tab) {
    modal = document.getElementById('auth-modal');
    if (!modal) return;
    switchTab(tab || 'login');
    modal.showModal();
    if (TS_SITE_KEY) {
      tsWidgetLogin    = renderTurnstile('ts-login');
      tsWidgetRegister = renderTurnstile('ts-register');
    }
  }

  function closeModal() {
    if (modal) modal.close();
  }

  function switchTab(name) {
    activeTab = name;
    document.querySelectorAll('.auth-tab').forEach(function (t) {
      var on = t.dataset.tab === name;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', String(on));
    });
    document.querySelectorAll('.auth-panel').forEach(function (p) {
      p.hidden = p.dataset.panel !== name;
    });
    clearError('login-error');
    clearError('register-error');
  }

  function setError(id, msg) {
    var el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg;
    el.hidden = !msg;
  }

  function clearError(id) { setError(id, ''); }

  // ── Login ───────────────────────────────────────────────────────────────────
  function handleLogin(e) {
    e.preventDefault();
    var form = e.target;
    var submit = document.getElementById('login-submit');
    var username = form.elements.username.value.trim();
    var password = form.elements.password.value;
    if (!username || !password) { setError('login-error', '请填写用户名和密码'); return; }
    submit.disabled = true;
    submit.textContent = '登录中…';
    clearError('login-error');
    apiFetch(LOGIN_PATH, { username: username, password: password, turnstileToken: getTsToken(tsWidgetLogin) })
      .then(function (data) {
        if (data.success && data.data && data.data.token) {
          saveAuth({
            token: data.data.token,
            identity: data.data.identity,
            expiresAt: data.expiresAt || (Date.now() + 7 * 24 * 60 * 60 * 1000),
          });
          closeModal();
          updateNav();
        } else if (data.data && data.data.requireTwoFactor) {
          setError('login-error', '暂不支持两步验证，请通过其他方式登录');
        } else {
          setError('login-error', data.message || '登录失败，请检查用户名和密码');
          resetTs(tsWidgetLogin);
        }
      })
      .catch(function () { setError('login-error', '网络错误，请稍后重试'); resetTs(tsWidgetLogin); })
      .finally(function () { submit.disabled = false; submit.textContent = '登录'; });
  }

  // ── Register ────────────────────────────────────────────────────────────────
  function handleRegister(e) {
    e.preventDefault();
    var form = e.target;
    var submit = document.getElementById('register-submit');
    var username = form.elements.username.value.trim();
    var password = form.elements.password.value;
    if (!username || !password) { setError('register-error', '请填写用户名和密码'); return; }
    if (password.length < 8) { setError('register-error', '密码至少8位'); return; }
    submit.disabled = true;
    submit.textContent = '注册中…';
    clearError('register-error');
    apiFetch(REG_PATH, { username: username, password: password, turnstileToken: getTsToken(tsWidgetRegister) })
      .then(function (data) {
        if (data.success && data.data && data.data.token) {
          saveAuth({
            token: data.data.token,
            identity: data.data.identity,
            expiresAt: data.expiresAt || (Date.now() + 7 * 24 * 60 * 60 * 1000),
          });
          closeModal();
          updateNav();
        } else if (data.success && data.data && data.data.requireLogin) {
          switchTab('login');
          setError('login-error', '注册成功，请登录');
        } else {
          setError('register-error', data.message || '注册失败');
          resetTs(tsWidgetRegister);
        }
      })
      .catch(function () { setError('register-error', '网络错误，请稍后重试'); resetTs(tsWidgetRegister); })
      .finally(function () { submit.disabled = false; submit.textContent = '注册并登录'; });
  }

  // ── Init ────────────────────────────────────────────────────────────────────
  function init() {
    updateNav();

    // Load Turnstile config
    apiGet(CONFIG_PATH).then(function (r) {
      if (r && r.data && r.data.turnstileEnabled && r.data.turnstileSiteKey) {
        TS_SITE_KEY = r.data.turnstileSiteKey;
        loadTurnstileScript();
      }
    }).catch(function () {});

    // Wire up nav login button
    var loginBtn = document.getElementById('nav-login-btn');
    if (loginBtn) loginBtn.addEventListener('click', function () { window.location.href = 'https://api.xxssxx.top/login'; });

    // Wire up nav logout
    var logoutBtn = document.getElementById('nav-logout');
    if (logoutBtn) logoutBtn.addEventListener('click', function () { clearAuth(); updateNav(); });

    // Wire up modal close button + backdrop click
    var closeBtn = document.getElementById('auth-modal-close');
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    var m = document.getElementById('auth-modal');
    if (m) m.addEventListener('click', function (e) { if (e.target === m) closeModal(); });

    // Wire up tabs
    document.querySelectorAll('.auth-tab').forEach(function (t) {
      t.addEventListener('click', function () { switchTab(t.dataset.tab); });
    });

    // Wire up forms
    var loginForm = document.getElementById('login-panel');
    if (loginForm) loginForm.addEventListener('submit', handleLogin);
    var regForm = document.getElementById('register-panel');
    if (regForm) regForm.addEventListener('submit', handleRegister);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Expose openModal globally so tiles/buttons can call it
  window.xxsxOpenAuth = openModal;
})();
