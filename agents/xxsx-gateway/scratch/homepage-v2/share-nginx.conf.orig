server {
    listen 80;
    listen [::]:80;
    server_name share.xxssxx.top;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name share.xxssxx.top;

    ssl_certificate     /etc/letsencrypt/live/share.xxssxx.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/share.xxssxx.top/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL_SHARE:10m;

    root /var/www/xxsx-share;
    index index.html;
    charset utf-8;

    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://icons.duckduckgo.com; style-src 'self'; script-src 'self' https://static.cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" always;

    # ── sites-full.js auth gate: cookie presence ─────────────────────────────
    location = /_auth_check {
        internal;
        if ($http_cookie ~* "xxsx-session=") { return 200; }
        return 401;
    }

    location = /assets/data/sites-full.js {
        auth_request /_auth_check;
        error_page 401 403 = @data_forbidden;
        expires epoch;
        try_files $uri =404;
    }

    location @data_forbidden {
        default_type application/javascript;
        return 401 'window.XXSX_SITES=[];window.XXSX_AUTH_REQUIRED=true;';
    }

        location = /api/feedback.php {
        limit_req zone=xxsx_auth_rate burst=5 nodelay;
        client_max_body_size 16k;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/xxsx-share/api/feedback.php;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php-fpm/www.sock;
        fastcgi_read_timeout 15s;
        fastcgi_hide_header X-Powered-By;
    }

    location = /api/codexradar-iq.php {
        limit_req zone=xxsx_auth_rate burst=10 nodelay;
        client_max_body_size 8k;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/xxsx-share/api/codexradar-iq.php;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php-fpm/www.sock;
        fastcgi_read_timeout 15s;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ \.php(?:/|$) {
        return 404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ^~ /assets/data/ {
        expires epoch;
        try_files $uri =404;
    }

    location = /assets/css/site.css {
        expires epoch;
        try_files $uri =404;
    }

    location ~* ^/assets/js/(?:common|api-list|api-detail|feedback|server-list)\.js$ {
        expires epoch;
        try_files $uri =404;
    }

    location ~* \.(?:css|js|png|jpg|jpeg|gif|ico|svg|webp|woff2?)$ {
        expires 7d;
        try_files $uri =404;
    }

    location ~ /\. {
        deny all;
    }

    access_log /var/log/nginx/share.xxssxx.top.access.log main;
    error_log  /var/log/nginx/share.xxssxx.top.error.log warn;
}
