+func fetchToutiaoHotTopics(ctx context.Context) ([]chatRoomHotTopic, error) {
+	body, err := fetchChatRoomHotTopicBody(ctx, "https://www.toutiao.com/hot-event/hot-board/?origin=toutiao_pc")
+	if err != nil {
+		fallback, fallbackErr := fetchChatRoomFallbackHotTopics(ctx, "toutiao", "头条热榜")
+		if fallbackErr == nil && len(fallback) > 0 {
+			return fallback, nil
+		}
+		return nil, fmt.Errorf("toutiao: %v; fallback: %w", err, fallbackErr)
+	}
+	var response struct {
+		Data []struct {
+			Title string `json:"Title"`
+		} `json:"data"`
+	}
+	if err := common.Unmarshal(body, &response); err != nil {
+		return nil, fmt.Errorf("invalid response: %w", err)
+	}
+	topics := make([]chatRoomHotTopic, 0, len(response.Data))
+	for _, item := range response.Data {
+		title := strings.TrimSpace(item.Title)
+		if title == "" {
+			continue
+		}
+		topics = append(topics, chatRoomHotTopic{
+			Title: truncateChatRoomText(title, 120), Source: "头条热榜", URL: "https://www.toutiao.com/search/?keyword=" + url.QueryEscape(title),
+		})
+	}
+	if len(topics) == 0 {
+		return nil, errors.New("toutiao official endpoint returned no usable topics")
+	}
+	return topics, nil
+}
