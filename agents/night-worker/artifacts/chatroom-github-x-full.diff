+func fetchBilibiliHotTopics(ctx context.Context) ([]chatRoomHotTopic, error) {
+	body, err := fetchChatRoomHotTopicBodyWithReferer(ctx, "https://api.bilibili.com/x/web-interface/popular?ps=30&pn=1", "https://www.bilibili.com/")
+	if err != nil {
+		return nil, fmt.Errorf("bilibili: %w", err)
+	}
+	var response struct {
+		Code int `json:"code"`
+		Data struct {
+			List []struct {
+				Title string `json:"title"`
+			} `json:"list"`
+		} `json:"data"`
+	}
+	if err := common.Unmarshal(body, &response); err != nil {
+		return nil, fmt.Errorf("invalid response: %w", err)
+	}
+	topics := make([]chatRoomHotTopic, 0, len(response.Data.List))
+	for _, item := range response.Data.List {
+		title := strings.TrimSpace(item.Title)
+		if title == "" {
+			continue
+		}
+		topics = append(topics, chatRoomHotTopic{
+			Title: truncateChatRoomText(title, 120), Source: "哔哩哔哩热门", URL: "https://www.bilibili.com/popular",
+		})
+	}
+	if len(topics) == 0 {
+		return nil, errors.New("bilibili official endpoint returned no usable topics")
+	}
+	return topics, nil
+}
