+func fetchBaiduHotTopics(ctx context.Context) ([]chatRoomHotTopic, error) {
+	body, err := fetchChatRoomHotTopicBody(ctx, "https://top.baidu.com/api/board?platform=wise&tab=realtime")
+	if err != nil {
+		return nil, fmt.Errorf("baidu: %w", err)
+	}
+	var response struct {
+		Success bool `json:"success"`
+		Data    struct {
+			Cards []struct {
+				Content []struct {
+					Content []struct {
+						Word string `json:"word"`
+					} `json:"content"`
+				} `json:"content"`
+			} `json:"cards"`
+		} `json:"data"`
+	}
+	if err := common.Unmarshal(body, &response); err != nil {
+		return nil, fmt.Errorf("invalid response: %w", err)
+	}
+	topics := make([]chatRoomHotTopic, 0, 50)
+	for _, card := range response.Data.Cards {
+		for _, group := range card.Content {
+			for _, item := range group.Content {
+				title := strings.TrimSpace(item.Word)
+				if title == "" {
+					continue
+				}
+				topics = append(topics, chatRoomHotTopic{
+					Title: truncateChatRoomText(title, 120), Source: "百度热搜", URL: "https://www.baidu.com/s?wd=" + url.QueryEscape(title),
+				})
+			}
+		}
+	}
+	if len(topics) == 0 {
+		return nil, errors.New("baidu official endpoint returned no usable topics")
+	}
+	return topics, nil
+}
