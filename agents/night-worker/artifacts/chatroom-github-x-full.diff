+// chatRoomTopicSourceURL returns the canonical browsing/search URL for a hot
+// topic from a given source, used for both primary and fallback topics.
+func chatRoomTopicSourceURL(source string, title string) string {
+	switch normalizeChatRoomTopicSource(source) {
+	case "weibo":
+		return "https://s.weibo.com/weibo?q=" + url.QueryEscape(title)
+	case "bilibili":
+		return "https://search.bilibili.com/all?keyword=" + url.QueryEscape(title)
+	case "toutiao":
+		return "https://www.toutiao.com/search/?keyword=" + url.QueryEscape(title)
+	case "zhihu":
+		return "https://www.zhihu.com/search?type=content&q=" + url.QueryEscape(title)
+	case "baidu":
+		return "https://www.baidu.com/s?wd=" + url.QueryEscape(title)
+	case "tieba":
+		return "https://tieba.baidu.com/f/search/res?ie=utf-8&qw=" + url.QueryEscape(title)
+	case "github":
+		return "https://github.com/search?q=" + url.QueryEscape(title) + "&type=repositories"
+	case "x":
+		return "https://x.com/search?q=" + url.QueryEscape(title)
+	default:
+		return "https://www.douyin.com/hot"
+	}
+}
