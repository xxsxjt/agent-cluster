+// fetchGitHubHotTopics queries the GitHub search API for the most starred
+// repositories created within the last 7 days. The unauthenticated search
+// rate limit (10 requests/minute) is far above the hourly poll frequency.
+func fetchGitHubHotTopics(ctx context.Context) ([]chatRoomHotTopic, error) {
+	createdAfter := time.Now().UTC().AddDate(0, 0, -7).Format("2006-01-02")
+	endpoint := "https://api.github.com/search/repositories?q=" + url.QueryEscape("created:>"+createdAfter) + "&sort=stars&order=desc&per_page=20"
+	body, err := fetchChatRoomHotTopicBody(ctx, endpoint)
+	if err != nil {
+		return nil, fmt.Errorf("github: %w", err)
+	}
+	var response struct {
+		Items []struct {
+			FullName        string `json:"full_name"`
+			Description     string `json:"description"`
+			HTMLURL         string `json:"html_url"`
+			StargazersCount int    `json:"stargazers_count"`
+		} `json:"items"`
+	}
+	if err := common.Unmarshal(body, &response); err != nil {
+		return nil, fmt.Errorf("invalid response: %w", err)
+	}
+	topics := make([]chatRoomHotTopic, 0, len(response.Items))
+	for _, item := range response.Items {
+		name := strings.TrimSpace(item.FullName)
+		if name == "" {
+			continue
+		}
+		title := name
+		if description := strings.Join(strings.Fields(strings.TrimSpace(item.Description)), " "); description != "" {
+			title = name + "：" + description
+		}
+		if item.StargazersCount > 0 {
+			title = fmt.Sprintf("%s（★%d）", title, item.StargazersCount)
+		}
+		topicURL := strings.TrimSpace(item.HTMLURL)
+		if topicURL == "" {
+			topicURL = "https://github.com/" + name
+		}
+		topics = append(topics, chatRoomHotTopic{
+			Title: truncateChatRoomText(title, 120), Source: "GitHub 新星项目", URL: topicURL,
+		})
+	}
+	if len(topics) == 0 {
+		return nil, errors.New("github official endpoint returned no usable topics")
+	}
+	return topics, nil
+}
