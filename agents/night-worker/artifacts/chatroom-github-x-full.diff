+const chatRoomXGetDayTrendsEndpoint = "https://getdaytrends.com/"
+
+var chatRoomXTrendPattern = regexp.MustCompile(`<td class="main">\s*<a href="/trend/[^"]*"[^>]*>([^<]+)</a>`)
+
+// fetchXHotTopics scrapes worldwide X (Twitter) trending topics from
+// getdaytrends.com because x.com itself requires an authenticated session.
+func fetchXHotTopics(ctx context.Context) ([]chatRoomHotTopic, error) {
+	body, err := fetchChatRoomHotTopicBody(ctx, chatRoomXGetDayTrendsEndpoint)
+	if err != nil {
+		return nil, fmt.Errorf("x: %w", err)
+	}
+	topics := parseXHotTopics(body)
+	if len(topics) == 0 {
+		return nil, errors.New("x trend source returned no usable topics")
+	}
+	return topics, nil
+}
+
+func parseXHotTopics(body []byte) []chatRoomHotTopic {
+	matches := chatRoomXTrendPattern.FindAllSubmatch(body, -1)
+	topics := make([]chatRoomHotTopic, 0, len(matches))
+	seen := make(map[string]struct{}, len(matches))
+	for _, match := range matches {
+		title := html.UnescapeString(strings.Join(strings.Fields(string(match[1])), " "))
+		if title == "" {
+			continue
+		}
+		lowerTitle := strings.ToLower(title)
+		if _, exists := seen[lowerTitle]; exists {
+			continue
+		}
+		seen[lowerTitle] = struct{}{}
+		topics = append(topics, chatRoomHotTopic{
+			Title: truncateChatRoomText(title, 120), Source: "X 全球趋势",
+			URL: "https://x.com/search?q=" + url.QueryEscape(title),
+		})
+	}
+	return topics
+}
